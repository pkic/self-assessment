{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkic.org/wg/pqc/pqcmm/data/pqcmm-model.schema-1.1.0.json",
  "title": "PQC Maturity Model",
  "description": "Schema for a versioned, machine-readable PQCMM model definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "model", "scoring", "levels"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "abbreviation", "version", "scope", "subjectLabel", "description", "canonicalUrl"],
      "properties": {
        "id": { "const": "pqcmm" },
        "name": { "type": "string", "minLength": 1 },
        "abbreviation": { "const": "PQCMM" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "scope": { "const": "product-or-service" },
        "subjectLabel": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "format": "uri" }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "minimumLevel", "maximumLevel", "criterionStatuses", "rule"],
      "properties": {
        "method": { "const": "cumulative-all-criteria" },
        "minimumLevel": { "const": 0 },
        "maximumLevel": { "const": 5 },
        "criterionStatuses": {
          "const": ["not-assessed", "met", "not-met", "partial"]
        },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "$defs": {
    "markdown": { "type": "string" },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "assessmentQuestionIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-5]\\.1\\.[1-9][0-9]*$" },
        "text": { "$ref": "#/$defs/markdown" },
        "assessmentQuestionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-5]\\.[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-5]\\.[0-9]+\\.[0-9]+$" },
        "question": { "$ref": "#/$defs/markdown" },
        "guidance": { "$ref": "#/$defs/markdown" },
        "expectedInput": { "$ref": "#/$defs/markdown" },
        "purpose": { "$ref": "#/$defs/markdown" },
        "response": { "$ref": "#/$defs/questionResponse" }
      },
      "oneOf": [
        { "required": ["guidance"] },
        { "required": ["expectedInput", "purpose"] }
      ]
    },
    "responseOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "responseField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "text",
            "textarea",
            "date",
            "url",
            "boolean",
            "select",
            "multiselect",
            "cpe-2.3",
            "package-url"
          ]
        },
        "required": { "type": "boolean" },
        "hint": { "type": "string" },
        "rows": { "type": "integer", "minimum": 1, "maximum": 12 },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 256 },
        "options": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/responseOption" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["select", "multiselect"] } } },
          "then": { "required": ["options"] },
          "else": { "not": { "required": ["options"] } }
        },
        {
          "if": { "properties": { "type": { "const": "cpe-2.3" } } },
          "then": { "properties": { "pattern": { "const": "^cpe:2\\.3:(?:(?:\\\\.|[^:])*:){10}(?:\\\\.|[^:])*$" } }, "required": ["pattern"] }
        },
        {
          "if": { "properties": { "type": { "const": "package-url" } } },
          "then": { "properties": { "pattern": { "const": "^pkg:[a-z][a-z0-9.+-]*/[^\\s/]+(?:/[^\\s/]+)*(?:@[^\\s?#]+)?(?:\\?[^\\s#]+)?(?:#[^\\s]+)?$" } }, "required": ["pattern"] }
        }
      ]
    },
    "questionEvidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "required", "acceptedMediaTypes", "maxFiles"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "acceptedMediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "maxFiles": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "responseRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fields", "message"],
      "properties": {
        "kind": { "const": "at-least-one" },
        "fields": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" }
        },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "questionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/responseField" }
        },
        "evidence": { "$ref": "#/$defs/questionEvidenceRequest" },
        "rules": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/responseRule" }
        }
      }
    },
    "questionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-5]\\.[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["assessment", "intake"] },
        "introduction": { "$ref": "#/$defs/markdown" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-5]\\.e\\.[1-9][0-9]*$" },
        "text": { "$ref": "#/$defs/markdown" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "title", "description", "summary", "sourcePage", "criteria", "assessment", "evidenceChecklist"],
      "properties": {
        "number": { "type": "integer", "minimum": 0, "maximum": 5 },
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sourcePage": { "type": "string", "pattern": "^/wg/pqc/pqcmm/levels/" },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": ["introduction", "items"],
          "properties": {
            "introduction": { "$ref": "#/$defs/markdown" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/criterion" }
            }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["methodology", "groups"],
          "properties": {
            "methodology": { "$ref": "#/$defs/markdown" },
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/questionGroup" }
            }
          }
        },
        "evidenceChecklist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["introduction", "items"],
          "properties": {
            "introduction": { "$ref": "#/$defs/markdown" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidenceItem" }
            }
          }
        }
      }
    }
  }
}
